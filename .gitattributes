
# Auto detect file types, if no further configs are given. Set end-of-line to LF.
* text=auto eol=lf

# Specify the following file types to be text, and do the CRLF/LF conversion.
*.py text eol=lf

# Add following types to git-lfs if they exist.
*.pdf filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
ffmpeg filter=lfs diff=lfs merge=lfs -text
ffprobe filter=lfs diff=lfs merge=lfs -text
qt-faststart filter=lfs diff=lfs merge=lfs -text
